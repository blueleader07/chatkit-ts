{
  "name": "chatkit-ts",
  "version": "0.1.0",
  "description": "Community TypeScript implementation of OpenAI ChatKit server SDK - widgets, streaming, and protocol",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "npm-run-all clean lint test tsc",
    "clean": "rm -rf dist",
    "generate:schema": "cd /Users/n0160926/git/lyra-chatkit && uv run python /Users/n0160926/git/typescript-chatkit/scripts/export-schema.py",
    "generate:types": "npx json-schema-to-typescript schema/widget-card.json -o src/widgets/generated/widgets.generated.ts",
    "generate": "npm-run-all generate:schema generate:types",
    "lint": "eslint src/**/*.ts --fix",
    "prepublishOnly": "npm run build",
    "test": "jest --coverage",
    "tsc": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blueleader07/chatkit-ts.git"
  },
  "bugs": {
    "url": "https://github.com/blueleader07/chatkit-ts/issues"
  },
  "keywords": [
    "chatkit",
    "openai",
    "widgets",
    "streaming",
    "sse",
    "chat",
    "typescript"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "dependencies": {
    "uuid": "^9.0.0",
    "zod": "^3.24.0"
  },
  "engines": {
    "node": ">=18"
  }
}
